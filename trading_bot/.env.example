# Copy this file to `.env` and fill it in. `.env` is gitignored — NEVER commit it.
# This repository is PUBLIC. Committing real credentials would expose your account.

# ============================================================
# SAFETY SWITCH
# ============================================================
# true  = paper trading only, no real orders (default, recommended to start)
# false = LIVE trading against Robinhood with REAL money
DRY_RUN=true

# ============================================================
# WHAT TO TRADE
# ============================================================
WATCHLIST=AAPL,MSFT,SPY
HISTORY_PERIOD=3mo
HISTORY_INTERVAL=1d

# ============================================================
# LOOP
# ============================================================
POLL_SECONDS=900          # 15 minutes between evaluation cycles
RUN_ONCE=false            # true = run a single cycle and exit
RESPECT_MARKET_HOURS=true # skip cycles when US market is closed

# ============================================================
# STRATEGY (RSI mean-reversion)
# ============================================================
RSI_PERIOD=14
RSI_ENTRY=30              # buy when RSI drops below this (oversold)
RSI_EXIT=55              # exit when RSI rises above this (recovered)

# ============================================================
# RISK MANAGEMENT
# ============================================================
MAX_POSITION_PCT=0.10     # max fraction of equity per position
MAX_POSITION_DOLLARS=1000 # absolute per-position ceiling ($)
STOP_LOSS_PCT=0.05        # stop-loss distance below entry (5%)
MAX_OPEN_POSITIONS=5
MAX_DAILY_LOSS_PCT=0.03   # halt new buys after 3% daily drawdown

# ============================================================
# PAPER BROKER (DRY_RUN only)
# ============================================================
PAPER_STARTING_CASH=10000

# ============================================================
# ROBINHOOD CREDENTIALS (only used when DRY_RUN=false)
# ============================================================
RH_USERNAME=
RH_PASSWORD=
# Optional: TOTP secret so MFA logins can run unattended. In the Robinhood app,
# set up an authenticator app and paste the setup secret key here.
RH_MFA_SECRET=
